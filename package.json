{
  "name": "aesthetic-vscode-icons",
  "displayName": "Aesthetic icons",
  "version": "0.0.0",
  "description": "Aesthetic icon theme for Vscode",
  "categories": [
    "Themes"
  ],
  "keywords": [
    "aesthetic",
    "customization",
    "icon-theme",
    "icons",
    "theme"
  ],
  "publisher": "LuisMonsalve",
  "main": "./dist/extension.mjs",
  "scripts": {
    "setup": "bunx gitlys init",
    "build": "bunx tsdown && bun run copy-assets && bun run /src/generate_icons.ts",
    "watch": "bunx tsdown --watch",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "copy-assets": "mkdir -p dist/asset && cp -r src/asset/. dist/asset/",
    "lint": "oxlint --fix",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@stacklys/oxlint-config": "1.0.4",
    "@stacklys/tsconfig": "1.0.2",
    "@types/node": "26.6.6",
    "@types/vscode": "^1.144.0",
    "gitlys": "2.2.4",
    "tsdown": "0.23.4",
    "typescript": "^6.0.3",
    "unrun": "0.3.1"
  },
  "contributes": {
    "iconThemes": [
      {
        "id": "aesthetic-icons",
        "label": "Aesthetic icons",
        "path": "./dist/file_icons.json"
      }
    ],
    "configuration": {
      "title": "Aesthetic icons",
      "properties": {
        "aesthetic-icons.theme": {
          "type": "string",
          "default": "dark",
          "enum": [
            "dark",
            "light"
          ],
          "description": "Select the Aesthetic icon theme",
          "enumDescriptions": [
            "Dark theme",
            "Light theme"
          ]
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.17.0",
    "vscode": "^1.125.0"
  }
}