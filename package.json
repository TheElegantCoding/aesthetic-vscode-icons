{
  "publisher": "luis",
  "name": "aesthetic-icons",
  "displayName": "Aesthetic icons",
  "description": "Aesthetic icon theme for Visual Studio Code",
  "version": "0.0.1",
  "keywords": [
    "icons",
    "theme",
    "icon-theme",
    "customization",
    "aesthetic"
  ],
  "extensionKind": ["ui", "workspace"],
  "categories": ["Themes"],
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22.17.0",
    "bun": ">=1.1.0"
  },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "iconThemes": [{
      "id": "aesthetic-icons",
      "label": "Aesthetic icons",
      "path": "./dist/file_icons.json"
    }],
    "configuration": {
      "title": "Aesthetic icons",
      "properties": {
        "aesthetic-icons.theme": {
          "type": "string",
          "default": "dark",
          "enum": ["dark", "light"],
          "description": "Select the Aesthetic icon theme",
          "enumDescriptions": ["Dark theme", "Light theme"]
        }
      }
    }
  },
  "scripts": {
    "postinstall": "gitlys init",
    "preinstall": "npx only-allow bun",
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js && pnpm run copy-assets",
    "watch": "pnpm run copy-assets && npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "copy-assets": "shx mkdir -p dist/asset && shx cp -r src/asset/* dist/asset/",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-universal-code": "1.0.19",
    "gitlys": "2.2.0",
    "npm-run-all": "^4.1.5",
    "shx": "0.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
