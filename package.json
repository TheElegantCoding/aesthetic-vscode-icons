{
  "publisher": "LuisMonsalve",
  "name": "aesthetic-vscode-icons",
  "displayName": "Aesthetic icons",
  "description": "Aesthetic icon theme for Vscode",
  "version": "0.0.0",
  "keywords": [
    "icons",
    "theme",
    "icon-theme",
    "customization",
    "aesthetic"
  ],
  "extensionKind": ["ui", "workspace"],
  "categories": ["Themes"],
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22.17.0",
    "bun": ">=1.1.0"
  },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "iconThemes": [{
      "id": "aesthetic-icons",
      "label": "Aesthetic icons",
      "path": "./dist/file_icons.json"
    }],
    "configuration": {
      "title": "Aesthetic icons",
      "properties": {
        "aesthetic-icons.theme": {
          "type": "string",
          "default": "dark",
          "enum": ["dark", "light"],
          "description": "Select the Aesthetic icon theme",
          "enumDescriptions": ["Dark theme", "Light theme"]
        }
      }
    }
  },
  "scripts": {
    "postinstall": "bunx gitlys init",
    "preinstall": "npx only-allow bun",
    "playground": "bun ./src/module/playground.ts",
    "build": "bunx tsup && bun run copy-assets && bun run playground",
    "watch": "bunx tsup --watch",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "copy-assets": "shx mkdir -p dist/asset && shx cp -r src/asset/* dist/asset/",
    "lint": "eslint --fix"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/vscode": "^1.125.0",
    "eslint-config-universal-code": "1.1.2",
    "gitlys": "2.2.1",
    "npm-run-all": "^4.1.5",
    "shx": "0.4.0",
    "tsup": "8.5.1",
    "typescript": "^6.0.3"
  }
}
