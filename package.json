{
  "publisher": "LuisMonsalve",
  "name": "aesthetic-vscode-icons",
  "displayName": "Aesthetic icons",
  "description": "Aesthetic icon theme for Vscode",
  "version": "0.0.0",
  "keywords": [
    "icons",
    "theme",
    "icon-theme",
    "customization",
    "aesthetic"
  ],
  "extensionKind": ["ui", "workspace"],
  "categories": ["Themes"],
  "main": "./dist/extension.mjs",
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22.17.0",
    "bun": ">=1.1.0"
  },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "iconThemes": [{
      "id": "aesthetic-icons",
      "label": "Aesthetic icons",
      "path": "./dist/file_icons.json"
    }],
    "configuration": {
      "title": "Aesthetic icons",
      "properties": {
        "aesthetic-icons.theme": {
          "type": "string",
          "default": "dark",
          "enum": ["dark", "light"],
          "description": "Select the Aesthetic icon theme",
          "enumDescriptions": ["Dark theme", "Light theme"]
        }
      }
    }
  },
  "scripts": {
    "setup": "bunx gitlys init",
    "playground": "bun ./src/module/playground.ts",
    "build": "bunx tsdown && bun run copy-assets && bun run playground",
    "watch": "bunx tsdown --watch",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "copy-assets": "shx mkdir -p dist/asset && shx cp -r src/asset/* dist/asset/",
    "lint": "oxlint --fix",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@stacklys/oxlint-config": "1.0.4",
    "@stacklys/tsconfig": "1.0.2",
    "@types/node": "26.6.6",
    "@types/vscode": "^1.144.0",
    "gitlys": "2.2.4",
    "shx": "0.4.0",
    "tsdown": "0.23.4",
    "typescript": "^6.0.3",
    "unrun": "0.3.1"
  }
}
