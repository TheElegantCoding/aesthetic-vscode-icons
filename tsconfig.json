{
  "extends": "@stacklys/tsconfig/strict",
  "compilerOptions": {
    "paths": {
      "@src/*": ["./src/*"],
      "@global/*": ["./src/global/*"],
      "@module/*": ["./src/module/*"],
      "@public/*": ["./public/*"],
      "@script/*": ["./script/*"]
    },
    "types": ["node", "vscode"]
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist"]
}